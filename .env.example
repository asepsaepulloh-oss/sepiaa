# ==========================================
# SEPIA STORE - KONFIGURASI ENVIRONMENT
# ==========================================

# 1. DATABASE (Turso / LibSQL)
# Saat deploy ke Vercel, isi URL dan Auth Token dari https://turso.tech
# Jika dikosongkan saat di lokal, otomatis fallback ke SQLite file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. QRIS PAYMENT GATEWAY MANDIRI (GoBiz / Dynamic QRIS)
QRIS_GATEWAY_URL="https://gomerch-beta.vercel.app"
QRIS_API_KEY="qris_live_MASUKKAN_API_KEY_ANDA_DISINI"
QRIS_WEBHOOK_SECRET="whsec_MASUKKAN_SIGNING_SECRET_ANDA_DISINI"

# 3. DOMAIN APLIKASI
# Lokal: http://localhost:3000 | Vercel: https://nama-proyek-anda.vercel.app
APP_URL=http://localhost:3000

# 4. ADMIN & KEAMANAN
# Password & session secret untuk akses dashboard admin di /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sepia123#super
ADMIN_SESSION_SECRET=kombinasi-kunci-rahasia-string-acak-panjang-min-32-karakter
